rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Documents des bases de connaissance : upload réservé aux admins
    // (custom claim `admin`). Lecture interdite côté client — seul le
    // service d'ingestion (Admin SDK) y accède.
    match /assistants/{assistantId}/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|text/.*|application/vnd.openxmlformats-officedocument.*'
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
