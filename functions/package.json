{
  "name": "functions",
  "description": "Cloud Functions (Genkit) pour le POC IA — assistants, RAG, chat",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "genkit:dev": "genkit start -- npx tsx --watch src/index.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.42.0",
    "@google-cloud/discoveryengine": "^3.2.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "genkit": "^1.42.0"
  },
  "devDependencies": {
    "genkit-cli": "^1.42.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.2"
  }
}
