# Copie en `functions/.env` si tu dois surcharger les valeurs par défaut.
# Toutes sont optionnelles — voir functions/src/config.ts.

# Région où appeler les modèles Gemini (Vertex AI)
VERTEX_LOCATION=us-central1

# Emplacement des data stores Vertex AI Search : global | eu | us
SEARCH_LOCATION=global

# Région de déploiement des functions
FUNCTIONS_REGION=europe-west1

# Région du bucket Cloud Storage par défaut (pour le trigger ingestDocument).
# À renseigner si `firebase deploy` signale un mismatch de région.
# STORAGE_REGION=us-central1

# Modèle Gemini par défaut d'un nouvel assistant
DEFAULT_MODEL=gemini-flash-latest
